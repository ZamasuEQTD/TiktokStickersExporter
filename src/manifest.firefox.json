{
  "manifest_version": 3,
  "name": "TikTok Stickers Exporter",
  "version": "1.7.1",
  "description": "Export TikTok Stickers easily",
  "browser_specific_settings": {
    "gecko": {
      "id": "tiktok-stickers-exporter@example.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "downloads",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tiktok.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "converter.worker.js",
        "icons/*"
      ],
      "matches": [
        "*://*.tiktok.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}

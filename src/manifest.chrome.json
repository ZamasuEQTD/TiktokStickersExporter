{
  "manifest_version": 3,
  "name": "TikTok Stickers Exporter",
  "version": "1.2.0",
  "description": "Export TikTok Stickers easily",
  "minimum_chrome_version": "94",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["converter.worker.js"],
      "matches": ["*://*.tiktok.com/*"]
    }
  ]
}

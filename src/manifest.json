{
  "manifest_version": 3,
  "name": "TikTok Stickers Exporter",
  "version": "1.0.0",
  "description": "Export TikTok Stickers easily",
  "browser_specific_settings": {
    "gecko": {
      "id": "tiktok-stickers-exporter@example.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TikTok Stickers Exporter"
  }
}
